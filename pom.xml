<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.sakurain.mc</groupId>
    <artifactId>easytp</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <name>EasyTP</name>
    <description>A lightweight teleport plugin with random teleport and TPA requests for PaperMC and Purpur 26.1.2 - 26.2</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Pin an exact -stable build. A range such as [26.1.2.build,) resolves to the HIGHEST
            matching version, which in this repository is a 26.3 alpha. Compiling against an
            unreleased API while declaring api-version 26.1.2 is how a plugin ends up throwing
            NoSuchMethodError on the very server it claims to support, and Paper labels Maven
            ranges "Discouraged" for exactly this reason. Keep this pinned to the oldest stable
            API the plugin targets.
        -->
        <paper.api.version>26.1.2.build.72-stable</paper.api.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
